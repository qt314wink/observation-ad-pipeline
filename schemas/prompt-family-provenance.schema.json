{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qt314wink/observation-ad-pipeline/schemas/prompt-family-provenance.schema.json",
  "title": "Observation Prompt Family Provenance",
  "type": "object",
  "required": ["canonicalSource", "derivationType", "sourceVersion", "allowedLocalOverrides", "forbiddenLocalMutations"],
  "additionalProperties": false,
  "properties": {
    "canonicalSource": {
      "type": "object",
      "required": ["project", "locator", "authorityStatus"],
      "additionalProperties": false,
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "authorityStatus": {"enum": ["canonical", "provisional", "unresolved"]}
      }
    },
    "derivationType": {
      "enum": ["verbatim", "bounded-adaptation", "semantic-translation", "experimental"]
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^(sha256:[a-f0-9]{64}|unresolved)$"
    },
    "familyBinding": {
      "type": "object",
      "required": ["path", "id", "protectedFields", "protectedDigest"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^prompt-packs/.+\\.ya?ml$"},
        "id": {"type": "string", "minLength": 1},
        "protectedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "protectedDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "allowedLocalOverrides": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "forbiddenLocalMutations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
