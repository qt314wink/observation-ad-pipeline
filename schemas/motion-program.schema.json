{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OBSAD Motion Program IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "semantic",
    "structure",
    "preservation",
    "materials",
    "scenes",
    "lighting",
    "camera",
    "temporal",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^motion:[a-z0-9._:-]+$"
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "topology",
        "intent",
        "perceptual_goal"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "enum": [
            "radial_annular",
            "radial_petaled",
            "lattice",
            "stratified_relief",
            "directional_procession",
            "network",
            "cellular",
            "architecture",
            "portrait_anchor",
            "material_macro"
          ]
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "perceptual_goal": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regions"
      ],
      "properties": {
        "symmetry_order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "movable"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9._-]+$"
              },
              "movable": {
                "type": "boolean"
              },
              "radius": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locks",
        "prohibited"
      ],
      "properties": {
        "locks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "prohibited": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "materials": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "description",
          "response"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "grammar",
          "duration_s",
          "channels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "grammar": {
            "enum": [
              "radial.counterphase",
              "radial.hinged_aperture",
              "lattice.excavation",
              "relief.stratified",
              "directional.procession",
              "network.propagation",
              "cellular.diffusion",
              "architecture.depth",
              "portrait.anchor",
              "material.macro"
            ]
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "primitive",
                "target",
                "easing"
              ],
              "properties": {
                "primitive": {
                  "enum": [
                    "rotate.local",
                    "rotate.counterphase",
                    "translate.radial",
                    "translate.tangential",
                    "translate.depth",
                    "fold.root_hinge",
                    "fold.medial_ridge",
                    "fold.saddle",
                    "fold.counter",
                    "reveal.occlusion",
                    "reveal.mask_growth",
                    "reveal.density",
                    "reveal.aperture",
                    "light.specular_sweep",
                    "light.vein_propagate",
                    "light.caustic_confined",
                    "light.rim_migrate",
                    "network.propagate",
                    "network.tension",
                    "cell.normal_displace",
                    "cell.neighbor_diffuse",
                    "camera.dolly",
                    "camera.pan",
                    "camera.focus_rack",
                    "temporal.phase_offset",
                    "temporal.pulse",
                    "temporal.settle",
                    "temporal.inverse_reassemble"
                  ]
                },
                "target": {
                  "type": "string"
                },
                "amplitude": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "strength": {
                  "type": "number"
                },
                "start": {
                  "type": "number"
                },
                "end": {
                  "type": "number"
                },
                "phase_offset_s": {
                  "type": "number",
                  "minimum": 0
                },
                "easing": {
                  "enum": [
                    "linear",
                    "sineInOut",
                    "sineOut",
                    "sineIn",
                    "smoothstep",
                    "quinticInOut",
                    "expoOut",
                    "expoIn"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": true
    },
    "camera": {
      "type": "object",
      "additionalProperties": true
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loop",
        "fps"
      ],
      "properties": {
        "loop": {
          "type": "boolean"
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "scene_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "first_last_state_match": {
          "type": "boolean"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_classes"
      ],
      "properties": {
        "maximum_silhouette_delta_percent": {
          "type": "number",
          "minimum": 0
        },
        "failure_classes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "base_image_prompt": {
          "type": "string"
        },
        "negative_prompt": {
          "type": "string"
        },
        "experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "parameter",
              "values",
              "prediction"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "parameter": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "minItems": 2
              },
              "prediction": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
