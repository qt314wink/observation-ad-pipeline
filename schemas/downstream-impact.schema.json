{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qt314wink/observation-ad-pipeline/schemas/downstream-impact.schema.json",
  "title": "Observation Downstream Impact Declaration",
  "type": "object",
  "required": ["familyId", "sourceProtectedDigest", "consumers"],
  "additionalProperties": false,
  "properties": {
    "familyId": {"type": "string", "minLength": 1},
    "sourceProtectedDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "classification", "target"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["prompt-pack", "renderer", "motion-workflow", "documentation", "test", "client-output"]},
          "classification": {"enum": ["must-revalidate", "compatible", "unaffected"]},
          "target": {"type": "string", "minLength": 1},
          "receipt": {
            "type": "object",
            "required": ["validatedProtectedDigest", "evidenceRef"],
            "additionalProperties": false,
            "properties": {
              "validatedProtectedDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "evidenceRef": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
