{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qt314wink/observation-ad-pipeline/schemas/motion-analysis.schema.json",
  "title": "Governed Motion Analysis Fixture",
  "type": "object",
  "required": ["schemaVersion", "fixtureId", "taxonomy", "sources"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "fixtureId": {"type": "string", "pattern": "^motion:"},
    "taxonomy": {"type": "array", "minItems": 8, "uniqueItems": true},
    "sources": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "path", "evidenceStatus", "requiredNextAction"],
        "properties": {
          "id": {"type": "string", "pattern": "^video:"},
          "path": {"type": "string", "pattern": "^input/videos/.+\\.mp4$"},
          "evidenceStatus": {"enum": ["pending-source-verification", "verified"]},
          "requiredNextAction": {"type": "string", "minLength": 20},
          "observations": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

